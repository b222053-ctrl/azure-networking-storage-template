{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ARM template for deploying an Azure Virtual Network with Web and Database subnets",
    "author": "Azure Networking and Storage Project"
  },
  "parameters": {
    "vnetName": {
      "type": "string",
      "defaultValue": "vnet-secure-app",
      "metadata": {
        "description": "Name of the Virtual Network"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/16",
      "metadata": {
        "description": "Address prefix for the Virtual Network"
      }
    },
    "databaseSubnetName": {
      "type": "string",
      "defaultValue": "snet-database",
      "metadata": {
        "description": "Name of the Database subnet"
      }
    },
    "databaseSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/27",
      "metadata": {
        "description": "Address prefix for the Database subnet"
      }
    },
    "webSubnetName": {
      "type": "string",
      "defaultValue": "snet-web",
      "metadata": {
        "description": "Name of the Web subnet"
      }
    },
    "webSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.0.1.0/27",
      "metadata": {
        "description": "Address prefix for the Web subnet"
      }
    },
    "enableStorageServiceEndpoint": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable Microsoft.Storage service endpoint on Database subnet"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "Environment": "Demo",
        "Project": "AzureNetworkingStorage"
      },
      "metadata": {
        "description": "Tags to apply to all resources"
      }
    }
  },
  "variables": {
    "nsgName": "[concat('nsg-', parameters('webSubnetName'))]",
    "storageServiceEndpoint": [
      {
        "service": "Microsoft.Storage",
        "locations": [
          "[parameters('location')]"
        ]
      }
    ],
    "emptyArray": []
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-05-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "AllowHTTPS",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceAddressPrefix": "Internet",
              "destinationAddressPrefix": "*",
              "description": "Allow HTTPS traffic from the internet"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-05-01",
      "name": "[parameters('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
      ],
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('vnetAddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "[parameters('databaseSubnetName')]",
            "properties": {
              "addressPrefix": "[parameters('databaseSubnetPrefix')]",
              "serviceEndpoints": "[if(parameters('enableStorageServiceEndpoint'), variables('storageServiceEndpoint'), variables('emptyArray'))]",
              "privateEndpointNetworkPolicies": "Disabled",
              "privateLinkServiceNetworkPolicies": "Enabled"
            }
          },
          {
            "name": "[parameters('webSubnetName')]",
            "properties": {
              "addressPrefix": "[parameters('webSubnetPrefix')]",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
              },
              "privateEndpointNetworkPolicies": "Disabled",
              "privateLinkServiceNetworkPolicies": "Enabled"
            }
          }
        ]
      }
    }
  ],
  "outputs": {
    "vnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]"
    },
    "vnetName": {
      "type": "string",
      "value": "[parameters('vnetName')]"
    },
    "databaseSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('databaseSubnetName'))]"
    },
    "webSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('webSubnetName'))]"
    },
    "nsgId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
    }
  }
}
